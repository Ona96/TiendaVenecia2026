# Venecia — variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio (está en .gitignore).

# ---- Supabase (proyecto en supabase.com) ----
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO servidor (webhooks, seed, promociones). Jamás en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- PostgreSQL (Dashboard > Project Settings > Database > Connection string > URI) ----
# Conexión directa (puerto 5432): para migraciones de Prisma.
DATABASE_URL=
DIRECT_URL=

# ---- Mercado Pago (Fase 6) ----
# Sandbox primero: https://www.mercadopago.com.ar/developers/panel/app
# Sin estos valores, el checkout ofrece SOLO transferencia (nada simulado).
MP_ACCESS_TOKEN=
# Secreto del webhook (Cuenta > Integraciones > Webhook secret, formato whsec_...)
# Sin secreto, el webhook responde 401 (fail-closed).
MP_WEBHOOK_SECRET=
# Base pública del sitio para que MP notifique (ej.: https://venecia.com.ar)
MP_WEBHOOK_BASE_URL=

# ---- Email transaccional (Fase 6) ----
# Proveedor HTTP (Resend, Brevo, etc.). Sin credenciales: stub marcado que
# registra el email y reporta "no enviado" (nunca finge un envío).
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=

# ---- Google OAuth (opcional; solo con credenciales reales) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
