# Venecia — variables de entorno
# Copiar a .env.local y completar. NUNCA subir .env.local al repositorio.

# ---- Supabase (proyecto en supabase.com) ----
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO servidor (webhooks, verificación de pagos, seed). Jamás en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- PostgreSQL (Dashboard > Project Settings > Database > Connection string > URI) ----
# Conexión agrupada (pgbouncer, puerto 6543): para la app en runtime.
DATABASE_URL=
# Conexión directa (puerto 5432): para migraciones de Prisma.
DIRECT_URL=

# ---- Integraciones (stub hasta tener credenciales reales) ----
# Mercado Pago (sandbox)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Email transaccional (SMTP de la boutique o proveedor)
SMTP_URL=
# Google OAuth (opcional; se habilita solo con credenciales reales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
